---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import NetworkGraph from "../components/NetworkGraph.astro";

import headerPhoto from "../assets/hero/headerphoto.jpg";
import ctaBg from "../assets/photos2/backnew.jpg";

import barImg from "../assets/gallery2/dog2.jpg";
import dinnerImg from "../assets/gallery2/dinner2.jpg";
import matchaImg from "../assets/gallery2/matcha.jpg";
import museumImg from "../assets/gallery2/museum.jpg";
import jardinImg from "../assets/gallery2/jardin2.jpg";
import nailsImg from "../assets/gallery2/nails.jpg";
import thriftImg from "../assets/gallery2/thrift.jpg";
import punchbowlImg from "../assets/gallery2/punchbowl.jpg";

const logEntries = [
	{
		src: nailsImg,
		alt: "A manicure appointment at a nail studio",
		caption: "Nails from Zorina Nail Studio",
		city: "San Francisco, CA",
		tag: "Beauty",
		tagClass: "chip-rose",
		match: 90,
		friend: "Zoe",
	},
	{
		src: thriftImg,
		alt: "Racks of vintage clothing at a thrift market",
		caption: "Thrift at Normal NYC",
		city: "New York, NY",
		tag: "Shopping",
		tagClass: "chip-blue",
		match: 97,
		friend: "Maya",
	},
	{
		src: matchaImg,
		alt: "An iced matcha and a strawberry mochi",
		caption: "Sip at Matcha House",
		city: "New York, NY",
		tag: "Cafe",
		tagClass: "chip-brown",
		match: 91,
		friend: "Jordan",
	},
	{
		src: dinnerImg,
		alt: "A creamy pasta dish with herbs and peas",
		caption: "Dinner at Toulouse Petite",
		city: "Seattle, WA",
		tag: "Dinner",
		tagClass: "chip-terracotta",
		match: 96,
		friend: "Priya",
	},
	{
		src: punchbowlImg,
		alt: "A canyon swimming hole surrounded by white rock",
		caption: "Hike Santa Paula Punch Bowls",
		city: "Los Angeles, CA",
		tag: "Nature",
		tagClass: "chip-olive",
		match: 89,
		friend: "Sam",
	},
	{
		src: museumImg,
		alt: "The stone facade of Museo Anahuacalli",
		caption: "Tour through Museo Anahuacalli",
		city: "Mexico City, Mexico",
		tag: "Museum",
		tagClass: "chip-gold",
		match: 88,
		friend: "Nora",
	},
	{
		src: jardinImg,
		alt: "A statue surrounded by red and orange flowers",
		caption: "Sit at Jardin du Luxembourg",
		city: "Paris, France",
		tag: "Event",
		tagClass: "chip-olive",
		match: 93,
		friend: "Liam",
	},
	{
		src: barImg,
		alt: "Foosball tables and a neon-lit cocktail bar",
		caption: "Dance at Vzorkovna Club",
		city: "Prague, Czech Republic",
		tag: "Nightlife",
		tagClass: "chip-purple",
		match: 94,
		friend: "Alex",
	},
];

// Degree of separation the rec was surfaced from — randomized once per
// build (not per-request; this is static frontmatter), so the mix looks
// natural without needing to hand-author it per entry.
const degreeLabels = {
	1: "from your friend",
	2: "second degree friend",
	3: "third degree friend",
};
const avatarColors = ["bg-primary", "bg-secondary", "bg-sage"];
const logEntryMeta = logEntries.map((entry, i) => ({
	degree: Math.floor(Math.random() * 3) + 1,
	avatarColor: avatarColors[i % avatarColors.length],
}));
---

<Layout>
	<main>
		<!-- Hero — static two-column layout (photo card right, left-aligned
		     text left). Previously a pinned full-viewport stage with a
		     scroll-driven zoom on "best-informed" and an animated WebGL
		     gradient behind it; both removed 2026-08-26 per explicit request
		     — the word now sits as plain text and the section background is
		     flat white.

		     min-h-dvh + flex centering: explicit user call — the hero must
		     always fill exactly one viewport (you shouldn't see the next
		     section without scrolling) and stay vertically centered, on any
		     screen/browser-window size. Sizing uses vmin (not vw) throughout
		     so it responds to a short/wide window the same as a tall/narrow
		     one — vw alone would overflow a short viewport.

		     Sizes are the brand type-scale's exact spec value used as the
		     clamp() ceiling (Display 1 for the H1, Body-lg for the
		     paragraph, Meta for the caption) — full-size at generous
		     viewports, fluidly shrinking via vmin below that (the H1/button
		     vmin coefficients run higher than a literal minimum-to-spec
		     curve would need, so they reach that ceiling on ordinary screens
		     instead of only on very large ones — explicit user call, "make
		     the hero text/button bigger").

		     Stacks to one column below `sm` (text on top, photo below) —
		     phone width was cramping the two columns side-by-side; reverted
		     from an earlier "always side-by-side, never stack" call once
		     that turned out to look cramped on phones in practice. Side by
		     side again from `sm` up. -->
		<section class="flex min-h-dvh items-center bg-sand px-3 py-[clamp(2.5rem,6vmin,5rem)] sm:px-6 lg:px-8">
			<div class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-[clamp(1.5rem,4vmin,4rem)] sm:grid-cols-2">
				<div class="-ml-2 text-left sm:-ml-4 lg:-ml-6" data-reveal>
					<h1 class="font-display font-normal text-primary text-[clamp(1.6rem,9.5vmin,5.5rem)] leading-[0.94] tracking-[-0.03em]">
						The knowledge of your<br />
						<em class="italic font-bold">best-informed</em> friend.
					</h1>
					<p class="font-dm-sans mt-[clamp(0.4rem,2vmin,1.25rem)] max-w-xl text-text/70 text-[clamp(0.65rem,2.2vmin,1.1875rem)] leading-[1.55]">
						Vouch is the shared brain of where you and your friends go.
					</p>
					<button
						type="button"
						data-open-waitlist
						class="glass-pill-claret mt-[clamp(0.6rem,2.5vmin,1.75rem)] whitespace-nowrap px-[clamp(1rem,4.5vmin,2.75rem)] py-[clamp(0.5rem,2.2vmin,1.125rem)] font-dm-sans font-medium uppercase tracking-wide transition-transform hover:scale-[1.03] active:scale-[0.98] text-[clamp(0.7rem,2.4vmin,1rem)] leading-[1.6]"
					>
						Get Early Access
					</button>
				</div>

				<div
					class="relative overflow-hidden rounded-[var(--radius-xl)] shadow-xl h-[clamp(280px,86vmin,760px)]"
					data-reveal
					style="--reveal-delay: 120ms"
				>
					<Image
						src={headerPhoto}
						alt="Friends dancing and gathered around a bar mid-motion"
						class="h-full w-full object-cover grayscale"
					/>

					<!-- Duotone accent — CSS-only, no image processing. A
					     Fresh-Cut→Claret gradient blended with mix-blend-color
					     tints the grayscale photo's shadows green and
					     highlights red while preserving its luminance, so it
					     still reads as black-and-white with color accents
					     rather than a full color wash. -->
					<div
						class="pointer-events-none absolute inset-0 mix-blend-color opacity-60 bg-[linear-gradient(135deg,var(--color-primary),var(--color-claret))]"
						aria-hidden="true"
					></div>

					<div
						class="pointer-events-none absolute inset-x-0 bottom-0 h-[45%] bg-gradient-to-t from-black/55 to-transparent"
						aria-hidden="true"
					></div>

					<div class="absolute inset-x-[4%] bottom-[4%] flex items-center justify-between gap-2">
						<p class="eyebrow whitespace-nowrap text-sand text-[clamp(0.4rem,1.3vmin,0.75rem)] leading-[1.4] tracking-[0.09em]">
							Vouched by your friends
						</p>
						<div class="flex shrink-0" aria-hidden="true">
							<span class="flex items-center justify-center rounded-full bg-primary font-mono font-semibold text-bone ring-2 ring-sand h-[clamp(1.1rem,4vmin,2.25rem)] w-[clamp(1.1rem,4vmin,2.25rem)] text-[clamp(0.45rem,1.3vmin,0.75rem)]">
								M
							</span>
							<span class="-ml-2 flex items-center justify-center rounded-full bg-secondary font-mono font-semibold text-bone ring-2 ring-sand h-[clamp(1.1rem,4vmin,2.25rem)] w-[clamp(1.1rem,4vmin,2.25rem)] text-[clamp(0.45rem,1.3vmin,0.75rem)]">
								Z
							</span>
							<span class="-ml-2 flex items-center justify-center rounded-full bg-sage font-mono font-semibold text-bone ring-2 ring-sand h-[clamp(1.1rem,4vmin,2.25rem)] w-[clamp(1.1rem,4vmin,2.25rem)] text-[clamp(0.45rem,1.3vmin,0.75rem)]">
								J
							</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Problem/solution sections removed 2026-08-27 (explicit request),
		     replaced with an interactive network graph in that space. -->
		<NetworkGraph />

		<!-- Example log entries -->
		<section class="mx-auto max-w-7xl px-4 pb-6 sm:px-6 sm:pb-[var(--spacing-section-tight)] lg:px-8">
			<div class="text-center" data-reveal>
				<p class="eyebrow justify-center">Finds on Vouch</p>
				<h2 class="mt-4 font-display text-[clamp(2rem,4.5vw,3rem)] font-medium leading-[1.1] text-primary">
					Your next favorite experience.
				</h2>
				<p class="font-dm-sans mx-auto mt-4 max-w-5xl text-base text-text/80 sm:text-lg">
					Have confidence in your decisions — find the authentic, hidden favorites buried in your network's recs.
				</p>
			</div>

			<div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4 lg:gap-5">
				{
					logEntries.map((entry, i) => {
						const meta = logEntryMeta[i];
						return (
							<div
								class="group relative overflow-hidden rounded-[var(--radius-lg)]"
								data-reveal
								style={{ "--reveal-delay": `${Math.min(i, 5) * 60}ms` }}
							>
								<Image
									src={entry.src}
									alt={entry.alt}
									class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-105"
									loading="lazy"
								/>
								<span
									class:list={[
										entry.tagClass,
										"absolute left-2 top-2 px-2 py-1 text-[9px] font-dm-sans font-medium uppercase tracking-wide shadow-sm sm:left-3 sm:top-3 sm:text-[10px]",
									]}
								>
									{entry.tag}
								</span>
								<span class="chip-match font-instrument-sans absolute right-2 top-2 px-2 py-1 text-[11px] shadow-sm sm:right-3 sm:top-3">
									{entry.match}% match
								</span>
								<div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/45 to-transparent" aria-hidden="true" />
							<div class="absolute inset-x-2 bottom-2 flex items-center justify-end gap-1.5 sm:inset-x-3 sm:bottom-3">
									<span class="eyebrow whitespace-nowrap text-[8px] text-sand sm:text-[9px]">{degreeLabels[meta.degree]}</span>
									<div class="relative shrink-0">
										<span
											class:list={[
												meta.avatarColor,
												"flex h-5 w-5 items-center justify-center rounded-full font-mono text-[8px] font-semibold text-bone ring-2 ring-sand sm:h-6 sm:w-6",
											]}
											aria-hidden="true"
										>
											{entry.friend[0]}
										</span>
										{meta.degree > 1 && (
											<span
												class="absolute -bottom-1 -right-1 font-mono text-[10px] font-extrabold leading-none text-claret [text-shadow:0_0_2px_white,0_0_2px_white,0_0_4px_white]"
												aria-hidden="true"
											>
												{meta.degree}°
											</span>
										)}
									</div>
								</div>
							</div>
						);
					})
				}
			</div>
		</section>

		<!-- Final CTA -->
		<section class="relative overflow-hidden">
			<!-- Source file (src/assets/photos2/backnew.jpg) is now physically
			     rotated correctly on disk (sips --rotate 270, 2026-08-27) — no
			     CSS transform needed. The earlier CSS-rotate approach kept
			     guessing wrong on direction/crop; rotating the actual pixels
			     once removes that whole class of bug. -->
			<Image
				src={ctaBg}
				alt="A mountain lake at sunset, pink clouds reflected in the still water"
				class="absolute inset-0 h-full w-full object-cover object-[50%_60%]"
				loading="lazy"
			/>

			<div class="relative mx-auto max-w-3xl px-4 py-24 text-center sm:py-32" data-reveal>
				<p class="eyebrow text-bone/80">Live now</p>
				<h2 class="mt-4 font-display text-[clamp(2.25rem,5vw,3.5rem)] font-medium leading-[1.1] text-bone">
					Have you <em class="italic">vouched</em> for it yet?
				</h2>
				<p class="font-dm-sans mt-4 text-base text-bone/85 sm:text-lg">
					Join the beta and let Vouch start learning in the background.
				</p>
				<button
					type="button"
					data-open-waitlist
					class="glass-pill-claret mt-8 px-8 py-3.5 text-base font-dm-sans font-medium uppercase tracking-wide transition-transform hover:scale-[1.03] active:scale-[0.98]"
				>
					Get Early Access
				</button>
			</div>
		</section>
	</main>
</Layout>
