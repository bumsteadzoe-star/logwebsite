---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import RecCard from "../components/RecCard.astro";

import heroBack from "../assets/photos2/bagel.jpg";
import heroFront from "../assets/photos2/cool.jpg";

import notesItineraryImg from "../assets/problem/notes-itinerary.png";
import mapsLaImg from "../assets/problem/maps-la.png";
import chatgptSfImg from "../assets/problem/chatgpt-sf.png";
import instagramNycImg from "../assets/problem/instagram-nyc.png";
import voiceMemoImg from "../assets/problem/voice-memo-4.png";
import ctaBg from "../assets/photos2/backnew.jpg";

import barImg from "../assets/gallery2/dog2.jpg";
import dinnerImg from "../assets/gallery2/dinner2.jpg";
import matchaImg from "../assets/gallery2/matcha.jpg";
import museumImg from "../assets/gallery2/museum.jpg";
import jardinImg from "../assets/gallery2/jardin2.jpg";
import nailsImg from "../assets/gallery2/nails.jpg";
import thriftImg from "../assets/gallery2/thrift.jpg";
import punchbowlImg from "../assets/gallery2/punchbowl.jpg";

const logEntries = [
	{
		src: nailsImg,
		alt: "A manicure appointment at a nail studio",
		caption: "Nails from Zorina Nail Studio",
		city: "San Francisco, CA",
		tag: "Beauty",
		tagClass: "chip-rose",
		match: 90,
	},
	{
		src: thriftImg,
		alt: "Racks of vintage clothing at a thrift market",
		caption: "Thrift at Normal NYC",
		city: "New York, NY",
		tag: "Shopping",
		tagClass: "chip-blue",
		match: 97,
	},
	{
		src: matchaImg,
		alt: "An iced matcha and a strawberry mochi",
		caption: "Sip at Matcha House",
		city: "New York, NY",
		tag: "Cafe",
		tagClass: "chip-brown",
		match: 91,
	},
	{
		src: museumImg,
		alt: "The stone facade of Museo Anahuacalli",
		caption: "Tour through Museo Anahuacalli",
		city: "Mexico City, Mexico",
		tag: "Museum",
		tagClass: "chip-gold",
		match: 88,
	},
	{
		src: jardinImg,
		alt: "A statue surrounded by red and orange flowers",
		caption: "Sit at Jardin du Luxembourg",
		city: "Paris, France",
		tag: "Nature",
		tagClass: "chip-olive",
		match: 93,
	},
	{
		src: barImg,
		alt: "Foosball tables and a neon-lit cocktail bar",
		caption: "Dance at Vzorkovna Club",
		city: "Prague, Czech Republic",
		tag: "Nightlife",
		tagClass: "chip-purple",
		match: 94,
	},
	{
		src: dinnerImg,
		alt: "A creamy pasta dish with herbs and peas",
		caption: "Dinner at Toulouse Petite",
		city: "Seattle, WA",
		tag: "Dinner",
		tagClass: "chip-terracotta",
		match: 96,
	},
	{
		src: punchbowlImg,
		alt: "A canyon swimming hole surrounded by white rock",
		caption: "Hike Santa Paula Punch Bowls",
		city: "Los Angeles, CA",
		tag: "Nature",
		tagClass: "chip-olive",
		match: 89,
	},
];
---

<Layout>
	<main>
		<!-- Hero — a tall spacer wrapping a sticky, full-viewport stage. The
		     extra height is what "holds" the pinned zoom/fade moment as the
		     user scrolls; once they scroll past it, the sticky stage releases
		     naturally (plain CSS sticky behavior, no scroll-jacking/preventDefault). -->
		<div id="hero-pin" class="relative">
			<section class="sticky top-0 flex h-dvh items-center justify-center overflow-hidden bg-sage/10 px-4 text-center sm:px-6 lg:px-8">
				<canvas
					id="hero-shader-canvas"
					class="absolute inset-0 -z-10 h-full w-full"
					style="display: block;"
					aria-hidden="true"
				></canvas>
				<div
					class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/6 bg-gradient-to-b from-transparent to-bg sm:h-1/3"
					aria-hidden="true"
				></div>

				<div class="hero-text w-full max-w-4xl">
					<h1 class="font-display text-4xl font-medium leading-[1.1] tracking-tight text-primary sm:text-5xl lg:text-6xl">
						<span class="hero-fade">The knowledge of your</span><br />
						<em class="hero-zoom-word italic">best-informed</em>
						<span class="hero-fade"> friend.</span>
					</h1>
					<p class="hero-fade mx-auto mt-5 max-w-xl text-base text-text/70 sm:text-lg">
						Never wonder where to go again.<br class="hidden sm:block" /> Log surfaces experiences
						based on you and your network.
					</p>
					<button
						type="button"
						data-open-waitlist
						class="hero-fade glass-pill-green mt-7 px-8 py-3.5 text-base font-semibold transition-transform hover:scale-[1.03] active:scale-[0.98]"
					>
						Get Early Access
					</button>
				</div>
			</section>
		</div>

		<style>
			/* Pinned scroll-zoom is back (2026-08-05) with a much shorter hold
			   than before: 200vh → 140vh (100vh of extra scroll → 40vh), and
			   growth/fade now saturate at 80% of that instead of 60% — so the
			   "locked" pause after the word finishes growing is a brief ~8vh
			   beat before release, not the ~40vh dead gap that prompted
			   removing this earlier the same day. */
			#hero-pin {
				height: 140vh;
			}

			.hero-text {
				animation: hero-fade-up 0.7s ease-out 0.05s both;
			}

			.hero-fade {
				opacity: calc(1 - min(var(--hero-progress, 0), 0.8) * 1.25);
			}

			.hero-zoom-word {
				display: inline-block;
				transform-origin: var(--hero-origin-x, 50%) 60%;
				transform: scale(
					calc(1 + (var(--hero-max-scale, 3) - 1) * min(var(--hero-progress, 0), 0.8) / 0.8)
				);
			}

			@keyframes hero-fade-up {
				from {
					opacity: 0;
					transform: translateY(20px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
		</style>

		<script>
			function initHeroZoom() {
				const wrapper = document.getElementById("hero-pin");
				const word = document.querySelector<HTMLElement>(".hero-zoom-word");
				const textBlock = document.querySelector<HTMLElement>(".hero-text");
				if (!wrapper || !word || !textBlock) return;
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

				// Cap the zoom so "best-informed" stops growing once it's as wide
				// as the rest of the hero text (the text block's own width) —
				// never wider than that, never stretching to the screen edges.
				// Measured live (not a fixed multiplier) so it holds at any
				// viewport size or font-loading state.
				const measureMaxScale = () => {
					const prevTransform = word.style.transform;
					word.style.transform = "none";
					const naturalWidth = word.offsetWidth;
					word.style.transform = prevTransform;
					// The word is italic — its slanted glyphs visually overhang
					// past the right edge of its own (upright) layout box, an
					// overhang that grows with the scale. That's invisible at
					// small container widths but pushes past the viewport edge
					// on mobile specifically, where the target width is the
					// viewport itself with little margin to spare. Pull the
					// mobile target in a bit so the grown word has room for
					// that overhang and stays visually centered and contained.
					const isMobile = window.innerWidth < 640;
					const targetWidth = textBlock.offsetWidth * (isMobile ? 0.94 : 1);
					const maxScale = naturalWidth > 0 ? Math.max(targetWidth / naturalWidth, 1) : 1;
					wrapper.style.setProperty("--hero-max-scale", String(maxScale));
					// "friend." stays on the same line as the word (2 lines
					// total, not 3), so the word itself sits left-of-center on
					// that shared line — growing it from its own true center
					// would just push it further left. Anchor the growth near
					// the word's own left edge on mobile instead, so it grows
					// rightward into the middle of the line rather than
					// expanding symmetrically off the edge.
					wrapper.style.setProperty("--hero-origin-x", isMobile ? "15%" : "50%");
				};

				measureMaxScale();
				window.addEventListener("resize", measureMaxScale);

				let ticking = false;
				const update = () => {
					const scrollable = wrapper.offsetHeight - window.innerHeight;
					const rect = wrapper.getBoundingClientRect();
					const progress = scrollable > 0 ? Math.min(Math.max(-rect.top / scrollable, 0), 1) : 0;
					wrapper.style.setProperty("--hero-progress", String(progress));
					ticking = false;
				};

				update();
				window.addEventListener(
					"scroll",
					() => {
						if (!ticking) {
							requestAnimationFrame(update);
							ticking = true;
						}
					},
					{ passive: true },
				);
			}

			initHeroZoom();
			document.addEventListener("astro:page-load", initHeroZoom);
		</script>

		<!-- Hero background shader — a quiet, near-white/pale-sage noise wash,
		     ported from a React "Simplex Noise" shader (paper-shaders style,
		     Apache-2.0) to plain WebGL/TypeScript since this project has no
		     React/shadcn — same native-port approach used earlier for the
		     hero's zoom effect. Deliberately not pointer-reactive: the pinned
		     zoom-word is already this page's one signature interactive
		     moment, so this stays ambient (slow drift only) rather than
		     competing with it. Respects prefers-reduced-motion by rendering a
		     single static frame and skipping the animation loop entirely. -->
		<script>
			const HERO_SHADER_VERT = `attribute vec2 a_position;
void main() {
  gl_Position = vec4(a_position, 0.0, 1.0);
}`;

			const HERO_SHADER_FRAG = `#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif

uniform vec3 u_colors[8];
uniform vec4 u_scene;
uniform vec4 u_shape;
uniform vec4 u_surface;
uniform vec4 u_finish;
uniform vec4 u_transform;
uniform vec4 u_space;
uniform vec4 u_cursor;

#define u_resolution u_scene.xy
#define u_time u_scene.z
#define u_colorCount u_scene.w
#define u_scale u_shape.x
#define u_intensity u_shape.y
#define u_paramA u_shape.z
#define u_warp u_shape.w
#define u_detail u_surface.x
#define u_contrast u_surface.y
#define u_brightness u_surface.z
#define u_saturation u_surface.w
#define u_hue u_finish.x
#define u_vignette u_finish.y
#define u_blur u_finish.z
#define u_grain u_finish.w
#ifdef GL_FRAGMENT_PRECISION_HIGH
#define u_seed u_transform.x
#else
#define u_seed mod(u_transform.x, 31.0)
#endif
#define u_rotate u_transform.y
#define u_drift u_transform.z
#define u_oklab u_transform.w
#define u_offset u_space.xy
#define u_mouse u_space.zw
#define u_cursorPresence u_cursor.x
#define u_cursorEffect u_cursor.y
#define u_cursorStrength u_cursor.z
#define u_cursorRadius u_cursor.w

float hash21(vec2 p) {
#ifndef GL_FRAGMENT_PRECISION_HIGH
  p = mod(p, 31.0);
#endif
  p = fract(p * vec2(234.34, 435.345));
  p += dot(p, p + 34.23);
  return fract(p.x * p.y);
}

float grainHash(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}

float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(
    mix(hash21(i), hash21(i + vec2(1.0, 0.0)), u.x),
    mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), u.x),
    u.y);
}

float fbm(vec2 p) {
  float v = 0.0;
  float a = 0.5;
  for (int i = 0; i < 5; i++) {
    v += a * noise(p);
    p = p * 2.03 + vec2(17.0, 9.2);
    a *= 0.5;
  }
  return v;
}

vec3 srgbToLinear(vec3 c) {
  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c));
}
vec3 linearToSrgb(vec3 c) {
  return mix(c * 12.92, 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}
vec3 linToOklab(vec3 c) {
  float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
  float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
  float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
  l = pow(max(l, 0.0), 1.0 / 3.0);
  m = pow(max(m, 0.0), 1.0 / 3.0);
  s = pow(max(s, 0.0), 1.0 / 3.0);
  return vec3(
    0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
    1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
    0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
}
vec3 oklabToLin(vec3 c) {
  float l = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
  float m = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
  float s = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
  l = l * l * l; m = m * m * m; s = s * s * s;
  return vec3(
    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
    -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}
vec3 mixColour(vec3 a, vec3 b, float t) {
  if (u_oklab > 0.5) {
    vec3 la = linToOklab(srgbToLinear(a));
    vec3 lb = linToOklab(srgbToLinear(b));
    return clamp(linearToSrgb(oklabToLin(mix(la, lb, t))), 0.0, 1.0);
  }
  return mix(a, b, t);
}

vec3 palette(float x) {
  float n = max(u_colorCount - 1.0, 1.0);
  float f = clamp(x, 0.0, 1.0) * n;
  vec3 col = u_colors[0];
  for (int i = 0; i < 7; i++) {
    if (float(i) < n)
      col = mixColour(col, u_colors[i + 1], smoothstep(0.0, 1.0, clamp(f - float(i), 0.0, 1.0)));
  }
  return col;
}

vec3 hueRotate(vec3 col, float a) {
  const mat3 toYIQ = mat3(0.299, 0.596, 0.211, 0.587, -0.274, -0.523, 0.114, -0.322, 0.312);
  const mat3 toRGB = mat3(1.0, 1.0, 1.0, 0.956, -0.272, -1.106, 0.621, -0.647, 1.703);
  vec3 yiq = toYIQ * col;
  float ca = cos(a), sa = sin(a);
  yiq = vec3(yiq.x, yiq.y * ca - yiq.z * sa, yiq.y * sa + yiq.z * ca);
  return toRGB * yiq;
}

vec3 shade(vec2 uv, vec2 p, float t) {
  vec2 q = p * 0.32;
  float first = fbm(q - vec2(0.0, t * 0.06) + u_seed);
  float second = fbm(q * 2.0 + vec2(0.0, t * 0.064) - u_seed * 0.17);
  float shape = clamp(0.5 * first + 0.5 * second, 0.0, 1.0);
  float steps = 2.0 + floor(u_intensity * 18.0);
  float stepped = floor(shape * steps) / steps;
  float softened = mix(stepped, shape, u_paramA);
  return palette(softened);
}

void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution.xy;
  vec2 screenUv = uv;
  vec2 p = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
  float cursorMask = 0.0;

  if (u_cursorPresence > 0.001) {
    vec2 cursor = (0.5 * u_mouse * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
    vec2 cursorDelta = p - cursor;
    if (u_cursorEffect < 0.5) {
      p += cursor * u_cursorPresence * u_cursorStrength * 0.55;
    } else {
      float cursorDistance = length(cursorDelta);
      vec2 cursorDirection = cursorDelta / max(cursorDistance, 0.0001);
      cursorMask = u_cursorPresence * (1.0 - smoothstep(0.0, u_cursorRadius, cursorDistance));
      if (u_cursorEffect < 1.5) {
        p -= cursorDirection * cursorMask * u_cursorStrength * 0.24;
      } else if (u_cursorEffect < 2.5) {
        float cursorAngle = cursorMask * u_cursorStrength * 2.2;
        float cc = cos(cursorAngle), cs = sin(cursorAngle);
        p = cursor + mat2(cc, -cs, cs, cc) * cursorDelta;
      } else if (u_cursorEffect < 3.5) {
        float ripple = sin(cursorDistance / max(u_cursorRadius, 0.001) * 18.0 - u_time * 5.0);
        p -= cursorDirection * ripple * cursorMask * u_cursorStrength * 0.07;
      }
    }
  }

  uv = p * min(u_resolution.x, u_resolution.y) / u_resolution.xy + 0.5;
  p *= u_scale;
  if (abs(u_rotate) > 0.0001) {
    float cr = cos(u_rotate), sr = sin(u_rotate);
    p = mat2(cr, -sr, sr, cr) * p;
  }
  p += u_offset;
  if (u_drift > 0.0001)
    p += u_drift * vec2(sin(u_time * 0.31), cos(u_time * 0.23));
  if (u_warp > 0.0) {
    p += u_warp * (vec2(fbm(p * u_detail + u_seed), fbm(p * u_detail + vec2(5.2, 1.3))) - 0.5);
  }
  vec3 col;
  if (u_blur > 0.0) {
    float e = u_blur;
    float pe = e * u_scale;
    vec2 uvE = vec2(e) * min(u_resolution.x, u_resolution.y) / u_resolution.xy;
    col  = shade(uv, p, u_time) * 0.36;
    col += shade(uv + vec2(uvE.x, 0.0), p + vec2(pe, 0.0), u_time) * 0.16;
    col += shade(uv - vec2(uvE.x, 0.0), p - vec2(pe, 0.0), u_time) * 0.16;
    col += shade(uv + vec2(0.0, uvE.y), p + vec2(0.0, pe), u_time) * 0.16;
    col += shade(uv - vec2(0.0, uvE.y), p - vec2(0.0, pe), u_time) * 0.16;
  } else {
    col = shade(uv, p, u_time);
  }
  if (abs(u_contrast - 1.0) > 0.0001)
    col = (col - 0.5) * u_contrast + 0.5;
  if (abs(u_saturation - 1.0) > 0.0001) {
    float luma = dot(col, vec3(0.299, 0.587, 0.114));
    col = mix(vec3(luma), col, u_saturation);
  }
  if (abs(u_hue) > 0.0001)
    col = hueRotate(col, u_hue);
  if (abs(u_brightness) > 0.0001)
    col += u_brightness;
  if (u_vignette > 0.0001) {
    float vd = length(screenUv - 0.5) * 1.41421356;
    col *= 1.0 - u_vignette * smoothstep(0.35, 1.0, vd);
  }
  if (u_cursorPresence > 0.001 && u_cursorEffect > 3.5)
    col += (vec3(0.18) + col * 0.12) * cursorMask * u_cursorStrength;
  if (u_grain > 0.0001)
    col += (grainHash(gl_FragCoord.xy + vec2(u_seed * 17.0, u_seed * 31.0)) - 0.5) * u_grain;
  gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
}
`;

			// Log's palette, near-white progressing to a whisper of Sage — not
			// the reference component's dark/moody defaults.
			const HERO_SHADER_UNIFORMS = {
				// A spread of distinct whites and greens, not one blended wash —
				// pure white, warm cream-white, cool mint-white, then four
				// greens stepping from pale sage up to a soft moss accent
				// (Sage/Moss are Log's actual brand tokens, indices 3 and 6).
				colors: [
					[1.0, 1.0, 1.0],
					[0.957, 0.945, 0.91],
					[0.929, 0.949, 0.894],
					[0.863, 0.902, 0.788],
					[0.765, 0.839, 0.686],
					[0.624, 0.722, 0.522],
					[0.498, 0.627, 0.369],
					[0.498, 0.627, 0.369],
				] as [number, number, number][],
				colorCount: 7,
				scale: 1.2,
				intensity: 0.28,
				paramA: 0.5,
				warp: 0.18,
				detail: 1.4,
				contrast: 0.95,
				brightness: 0.0,
				saturation: 0.95,
				hue: 0.0,
				vignette: 0.06,
				blur: 0.001,
				grain: 0.02,
				seed: 4231.0,
				rotate: 0.0,
				offsetX: 0.05,
				offsetY: 0.1,
				drift: 0.02,
				oklab: 1.0,
				timeScale: -0.12,
			};

			function initHeroShader() {
				const canvas = document.getElementById("hero-shader-canvas") as HTMLCanvasElement | null;
				if (!canvas) return;

				const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

				const gl = canvas.getContext("webgl", { antialias: false });
				if (!gl) return;

				const compile = (type: number, src: string) => {
					const s = gl.createShader(type)!;
					gl.shaderSource(s, src);
					gl.compileShader(s);
					return s;
				};
				const program = gl.createProgram()!;
				const vertexShader = compile(gl.VERTEX_SHADER, HERO_SHADER_VERT);
				const fragmentShader = compile(gl.FRAGMENT_SHADER, HERO_SHADER_FRAG);
				gl.attachShader(program, vertexShader);
				gl.attachShader(program, fragmentShader);
				gl.linkProgram(program);
				gl.deleteShader(vertexShader);
				gl.deleteShader(fragmentShader);
				gl.useProgram(program);

				const buf = gl.createBuffer();
				gl.bindBuffer(gl.ARRAY_BUFFER, buf);
				gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
				const posLoc = gl.getAttribLocation(program, "a_position");
				gl.enableVertexAttribArray(posLoc);
				gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 0, 0);

				const uni = {
					colors: gl.getUniformLocation(program, "u_colors"),
					scene: gl.getUniformLocation(program, "u_scene"),
					shape: gl.getUniformLocation(program, "u_shape"),
					surface: gl.getUniformLocation(program, "u_surface"),
					finish: gl.getUniformLocation(program, "u_finish"),
					transform: gl.getUniformLocation(program, "u_transform"),
					space: gl.getUniformLocation(program, "u_space"),
					cursor: gl.getUniformLocation(program, "u_cursor"),
				};
				gl.uniform3fv(uni.colors, new Float32Array(HERO_SHADER_UNIFORMS.colors.flat()));
				gl.uniform4f(uni.shape, HERO_SHADER_UNIFORMS.scale, HERO_SHADER_UNIFORMS.intensity, HERO_SHADER_UNIFORMS.paramA, HERO_SHADER_UNIFORMS.warp);
				gl.uniform4f(uni.surface, HERO_SHADER_UNIFORMS.detail, HERO_SHADER_UNIFORMS.contrast, HERO_SHADER_UNIFORMS.brightness, HERO_SHADER_UNIFORMS.saturation);
				gl.uniform4f(uni.finish, HERO_SHADER_UNIFORMS.hue, HERO_SHADER_UNIFORMS.vignette, HERO_SHADER_UNIFORMS.blur, HERO_SHADER_UNIFORMS.grain);
				gl.uniform4f(uni.transform, HERO_SHADER_UNIFORMS.seed, HERO_SHADER_UNIFORMS.rotate, HERO_SHADER_UNIFORMS.drift, HERO_SHADER_UNIFORMS.oklab);
				gl.uniform4f(uni.cursor, 0, 0, 0, 0.3);

				let bounds = canvas.getBoundingClientRect();
				let raf = 0;
				let inView = true;
				let visible = document.visibilityState === "visible";
				const start = performance.now();

				const resizeCanvas = () => {
					const dpr = Math.min(window.devicePixelRatio || 1, 2);
					const rawWidth = Math.max(1, Math.round(bounds.width * dpr));
					const rawHeight = Math.max(1, Math.round(bounds.height * dpr));
					const pixelScale = Math.min(1, Math.sqrt(2_000_000 / Math.max(1, rawWidth * rawHeight)));
					const width = Math.max(1, Math.round(rawWidth * pixelScale));
					const height = Math.max(1, Math.round(rawHeight * pixelScale));
					if (canvas.width !== width || canvas.height !== height) {
						canvas.width = width;
						canvas.height = height;
						gl.viewport(0, 0, width, height);
					}
				};

				const renderFrame = (time: number) => {
					resizeCanvas();
					gl.uniform4f(uni.scene, canvas.width, canvas.height, time, HERO_SHADER_UNIFORMS.colorCount);
					gl.uniform4f(uni.space, HERO_SHADER_UNIFORMS.offsetX, HERO_SHADER_UNIFORMS.offsetY, 0, 0);
					gl.drawArrays(gl.TRIANGLES, 0, 3);
				};

				if (reduceMotion) {
					renderFrame(0);
					return;
				}

				const requestRender = () => {
					if (visible && inView && raf === 0) raf = requestAnimationFrame(render);
				};

				function render(now: number) {
					raf = 0;
					if (!visible || !inView) return;
					renderFrame(((now - start) / 1000) * HERO_SHADER_UNIFORMS.timeScale);
					requestRender();
				}

				const updateLayout = () => {
					bounds = canvas.getBoundingClientRect();
					requestRender();
				};
				window.addEventListener("resize", updateLayout);

				const resizeObserver = new ResizeObserver(updateLayout);
				resizeObserver.observe(canvas);

				const intersectionObserver = new IntersectionObserver(([entry]) => {
					inView = entry?.isIntersecting ?? true;
					if (inView) requestRender();
					else if (raf !== 0) {
						cancelAnimationFrame(raf);
						raf = 0;
					}
				});
				intersectionObserver.observe(canvas);

				document.addEventListener("visibilitychange", () => {
					visible = document.visibilityState === "visible";
					if (visible) requestRender();
					else if (raf !== 0) {
						cancelAnimationFrame(raf);
						raf = 0;
					}
				});

				requestRender();
			}

			initHeroShader();
			document.addEventListener("astro:page-load", initHeroShader);
		</script>

		<!-- The problem -->
