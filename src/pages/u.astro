---
/**
 * Bridge for profile links, `https://www.get-vouch.com/u/<username>` — what Profile → Share hands
 * out in the app, meant for an Instagram bio. vercel.json rewrites every `/u/<username>` here.
 *
 * With the app installed, iOS opens the link in the app (the AASA lists `/u/*`) and this page
 * never renders — except where universal links don't fire: in-app browsers (Instagram, TikTok…),
 * a link pasted into Safari, "Open in Safari". So on every phone this page opens the app by its
 * own scheme on that profile (`com.averyv12.log:///u/<username>`, the app's /u/[username]
 * route) and goes to the App Store only if nothing takes over (Daniela, 2026-10-19: "only to
 * app store if phone doesn't have it downloaded"). It used to send plain Safari straight to the
 * store, and used `log://`, which v1's Log app claims too.
 *
 * Standalone like open.astro: this page exists to be left immediately.
 */
const APP_STORE_URL =
  import.meta.env.PUBLIC_IOS_APP_STORE_URL || 'https://apps.apple.com/app/id6763411702';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vouch</title>
    <meta name="robots" content="noindex" />
    <meta name="apple-itunes-app" content="app-id=6763411702" />
  </head>
  <body
    style="margin:0;font-family:system-ui,-apple-system,'Helvetica Neue',Helvetica,Arial,sans-serif;background:#ffffff;color:#0c1a08;"
  >
    <main
      style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 24px;"
    >
      <h1 id="title" style="font-size:1.5rem;margin:0 0 8px;overflow-wrap:anywhere;">Opening Vouch…</h1>
      <p style="color:#5f646a;margin:0 0 24px;">
        If the app doesn&rsquo;t open, get it on the App Store.
      </p>
      <a
        id="open"
        href="com.averyv12.log:///"
        style="display:block;width:100%;max-width:320px;box-sizing:border-box;padding:14px 20px;border-radius:999px;background:#0c1a08;color:#ffffff;font-weight:600;text-decoration:none;margin-bottom:12px;"
        >Open in Vouch</a
      >
      <a href={APP_STORE_URL} style="color:#3d6b2f;font-weight:600;">Get Vouch on the App Store</a>
    </main>

    {/* `is:inline`: a bundled/deferred module would run too late (same as open.astro). */}
    <script is:inline define:vars={{ APP_STORE_URL }}>
      (function () {
        var parts = location.pathname.split('/').filter(Boolean);
        var name = '';
        try {
          name = decodeURIComponent(parts[0] === 'u' ? parts[1] || '' : '').replace(/^@+/, '').trim();
        } catch (e) {}
        var appUrl = 'com.averyv12.log:///' + (name ? 'u/' + encodeURIComponent(name) : '');
        if (name) {
          document.title = '@' + name + ' on Vouch';
          document.getElementById('title').textContent = '@' + name + ' on Vouch';
        }
        document.getElementById('open').href = appUrl;

        var ua = navigator.userAgent;
        if (!/iPhone|iPad|iPod|Android/i.test(ua)) {
          window.location.replace(APP_STORE_URL);
          return;
        }
        // Hand-off to the app; the App Store only when nothing takes over (Daniela, 2026-10-19).
        //  - The app opens → the page is hidden / unloaded → no redirect.
        //  - A Safari sheet has focus at the 2 s mark ("Open this page in 'Vouch'?") → no redirect
        //    underneath it: the old fixed timer did that and sent people WITH the app to the store.
        //  - Otherwise (no app, or an in-app browser that ignores the scheme) → the App Store, once.
        //    Never retried: after Safari fails the scheme ("address is invalid"), every further
        //    navigation re-raises that alert (seen in Safari, 2026-10-19), so a retry loop strands
        //    the visitor in alerts. The two buttons on the page are the fallback.
        var handedOff = false;
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) handedOff = true;
        });
        window.addEventListener('pagehide', function () {
          handedOff = true;
        });
        window.location.href = appUrl;
        setTimeout(function () {
          if (handedOff || document.hidden) return;
          if (typeof document.hasFocus === 'function' && !document.hasFocus()) return;
          window.location.replace(APP_STORE_URL);
        }, 2000);
      })();
    </script>
  </body>
</html>
